cmake_minimum_required(VERSION 3.14)
# Exercise release policy with stale CPU options left by a previous native build.
set(DELTA_PORTABLE_RELEASE ON)
string(RANDOM LENGTH 12 suffix)
if(DEFINED ENV{TMPDIR})
  set(CMAKE_BINARY_DIR "$ENV{TMPDIR}/delta-policy-${suffix}")
elseif(DEFINED ENV{TEMP})
  set(CMAKE_BINARY_DIR "$ENV{TEMP}/delta-policy-${suffix}")
else()
  set(CMAKE_BINARY_DIR "/tmp/delta-policy-${suffix}")
endif()
file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}")
set(CMAKE_SYSTEM_PROCESSOR x86_64)
foreach(feature NATIVE SSE42 AVX AVX2 AVX_VNNI AVX_VNNI_INT8 AVX512 AVX512_VBMI AVX512_VNNI AVX512_BF16 FMA F16C BMI2 AMX_TILE AMX_INT8 AMX_BF16)
  set(GGML_${feature} ON CACHE BOOL "stale runner-specific setting" FORCE)
endforeach()
set(APPLE TRUE)
set(CMAKE_OSX_DEPLOYMENT_TARGET 26.0 CACHE STRING "stale SDK default" FORCE)
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/DeltaReleasePolicy.cmake")
delta_configure_release_cpu()
foreach(feature NATIVE SSE42 AVX AVX2 AVX_VNNI AVX_VNNI_INT8 AVX512 AVX512_VBMI AVX512_VNNI AVX512_BF16 FMA F16C BMI2 AMX_TILE AMX_INT8 AMX_BF16)
  if(GGML_${feature})
    message(FATAL_ERROR "Release requires unsupported CPU feature ${feature}")
  endif()
endforeach()
if(NOT CMAKE_OSX_DEPLOYMENT_TARGET STREQUAL "11.0")
  message(FATAL_ERROR "Release backends do not match the macOS 11 app contract")
endif()
if(NOT GGML_METAL_MACOSX_VERSION_MIN STREQUAL "11.0")
  message(FATAL_ERROR "Metal compilation target does not match the app")
endif()
message(STATUS "Portable release policy survives stale native cache settings")

# The fast x86_64 build: exactly the x86-64-v3 features, nothing newer.
set(DELTA_CPU_LEVEL "x86-64-v3" CACHE STRING "" FORCE)
delta_configure_release_cpu()
foreach(feature SSE42 AVX AVX2 FMA F16C BMI2)
  if(NOT GGML_${feature})
    message(FATAL_ERROR "x86-64-v3 build is missing ${feature}")
  endif()
endforeach()
foreach(feature NATIVE AVX_VNNI AVX_VNNI_INT8 AVX512 AVX512_VBMI AVX512_VNNI AVX512_BF16 AMX_TILE AMX_INT8 AMX_BF16)
  if(GGML_${feature})
    message(FATAL_ERROR "x86-64-v3 build requires unsupported CPU feature ${feature}")
  endif()
endforeach()
message(STATUS "x86-64-v3 release policy enables AVX2, FMA, F16C and BMI2 only")

file(REMOVE_RECURSE "${CMAKE_BINARY_DIR}")
