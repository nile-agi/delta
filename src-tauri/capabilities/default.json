{
  "identifier": "default",
  "description": "Default capabilities for the Delta app",
  "windows": ["main"],
  "remote": {
    "urls": ["http://localhost:*", "http://127.0.0.1:*"]
  },
  "permissions": [
    "core:default",
    "shell:allow-open",
    "shell:allow-spawn",
    "shell:allow-stdin-write",
    "shell:allow-kill",
    "shell:default",
    "process:default",
    "allow-stream-chat",
    "allow-abort-stream"
  ]
}
