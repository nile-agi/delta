#!/usr/bin/env bash
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"

# --- C++ formatting (clang-format) ---
CLANG_FMT="$(xcrun --find clang-format 2>/dev/null || which clang-format 2>/dev/null || true)"
if [ -n "$CLANG_FMT" ]; then
    CPP_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(cpp|h|hpp|c)$' | grep -v vendor/ || true)
    if [ -n "$CPP_FILES" ]; then
        echo "Formatting C++ files..."
        echo "$CPP_FILES" | while read -r file; do
            "$CLANG_FMT" -i -style=file "$REPO_ROOT/$file"
            git add "$REPO_ROOT/$file"
        done
    fi
fi

# --- Web formatting (prettier) ---
WEB_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|svelte|js|json|css|scss)$' | grep -v vendor/ | grep -v pnpm-lock || true)
if [ -n "$WEB_FILES" ]; then
    PRETTIER=""
    if [ -x "$REPO_ROOT/web/app/node_modules/.bin/prettier" ]; then
        PRETTIER="$REPO_ROOT/web/app/node_modules/.bin/prettier"
    fi

    if [ -n "$PRETTIER" ]; then
        echo "Formatting web files..."
        echo "$WEB_FILES" | while read -r file; do
            "$PRETTIER" --write "$REPO_ROOT/$file" --config "$REPO_ROOT/web/app/.prettierrc" 2>/dev/null || true
            git add "$REPO_ROOT/$file"
        done
    fi
fi
